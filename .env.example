# Demo-only Docker Compose credentials. Copy to .env and change them for any shared machine.
POSTGRES_PASSWORD=postgres_demo_pw
INGESTION_DB_PASSWORD=ingestion_demo_pw
SENTIMENT_DB_PASSWORD=sentiment_demo_pw
RECONCILIATION_DB_PASSWORD=reconciliation_demo_pw

# Set false when the corporate network blocks BigBasket or you want a deterministic demo.
SCRAPER_ENABLED=false
